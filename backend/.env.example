NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/smart_fleet_store

# Match the login service HS256 signing secret (at least 32 characters).
JWT_SECRET=
# Explicit localhost-only development access. Disabled by default.
DEV_MASTER_DATA_ACCESS=false

# Configure SMTP to send password reset links. Without SMTP, reset URLs are returned only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Optional admin bootstrap credentials; use the seed:admin command, not public signup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
